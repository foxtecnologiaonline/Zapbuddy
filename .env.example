# Supabase (Postgres + Storage + Auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Canal WhatsApp — 'cloud-api' (default, único aprovado para produção com
# usuários reais) ou 'evolution' (fallback/contingência — ver amendamento no
# CLAUDE.md). NÃO setar 'evolution' em produção salvo decisão explícita.
WHATSAPP_CHANNEL_PROVIDER=cloud-api

# WhatsApp Cloud API (Meta) — oficial, canal default
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Evolution API — só usado quando WHATSAPP_CHANNEL_PROVIDER=evolution
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_WEBHOOK_SECRET=

# Claude (Anthropic) — orquestrador LLM, provider primário (ver CLAUDE.md)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Fallback do orquestrador quando o Anthropic falha (créditos, rate limit,
# indisponibilidade) — reaproveita a MESMA OPENAI_API_KEY já usada pelo
# fallback de transcrição abaixo. Opcional: sem ela, o orquestrador só tem
# o Anthropic (comportamento de antes deste amendamento).
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Dashboard web
WEB_APP_URL=http://localhost:3000
SESSION_SECRET=

# Admin do Tom (/admin) — painel operacional interno (visitas, chamadas,
# contatos, assinaturas, erros, fila, infraestrutura). Senha única, sem
# usuário — é uso do operador, não dos clientes. Reaproveita SESSION_SECRET
# pra assinar o cookie de sessão do admin (ver apps/web/lib/admin-session.ts).
ADMIN_PASSWORD=

# Transcrição de áudio (Whisper) — mesma cadeia de provedores do ZapScript:
# Groq (whisper-large-v3-turbo, mais rápido/preciso em PT-BR) primeiro,
# OpenAI (whisper-1) como fallback. Pelo menos uma das duas precisa estar
# setada; com as duas, Groq é tentado primeiro (ver apps/worker/src/audio).
GROQ_API_KEY=
OPENAI_API_KEY=
# Teto de duração (segundos) antes de recusar transcrever — controle de custo.
MAX_AUDIO_DURATION_SEC=600

# Opcional: habilita os contadores (# usuários, # onboardings) em GET
# /api/health?key=... — sem isso, o endpoint só responde liveness (db/redis),
# sem números de negócio.
HEALTH_METRICS_SECRET=

# Fase 2 (docs/adr/0002) — Google Agenda: OAuth conectado pelo dashboard
# (apps/web/app/api/calendar). Criar credenciais OAuth 2.0 (tipo "Web
# application") no Google Cloud Console, com escopo calendar.events e
# GOOGLE_REDIRECT_URI = {WEB_APP_URL}/api/calendar/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# 2026-10 (motivo documentado no CLAUDE.md) — Outlook/Microsoft 365 como
# segunda opção de agenda (uma conexão por conta, Google OU Outlook, nunca
# os dois — conectar o outro substitui). Criar um app registration no Azure
# Portal (portal.azure.com → Microsoft Entra ID → App registrations → New
# registration): Authentication → adiciona a plataforma "Web" com o redirect
# URI = {WEB_APP_URL}/api/calendar/microsoft/callback; API permissions →
# Microsoft Graph → Delegated → Calendars.ReadWrite; Certificates & secrets
# → novo client secret (vira MICROSOFT_CLIENT_SECRET). Sem essas 3 variáveis
# preenchidas, o botão "Conectar Outlook" do dashboard falha de forma
# controlada (redireciona com ?calendar=error) — nunca derruba o Google, que
# continua funcionando normalmente.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/calendar/microsoft/callback

# Fase 2 — chave simétrica (32 bytes, base64) pra criptografar o refresh
# token da agenda conectada (Google ou Microsoft) antes de gravar no banco
# (packages/core/src/security/crypto.ts). Gerar com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Pesquisa autônoma do Tom e base de conhecimento (ver CLAUDE.md, amendamento
# "Pesquisa autônoma e aprendizado contínuo") — Tavily Search API, usada pela
# tool web_search e pelo job semanal de pesquisa proativa. Opcional: sem ela,
# a tool falha de forma controlada (Tom diz que não conseguiu buscar agora,
# nunca inventa resposta) e o job proativo só loga erro por tópico.
WEB_SEARCH_API_KEY=
# Embeddings da base de conhecimento (packages/core/src/llm/embeddings)
# reaproveitam a MESMA OPENAI_API_KEY já setada acima pro fallback de
# transcrição — nenhuma chave nova além de WEB_SEARCH_API_KEY.
# A mesma OPENAI_API_KEY também gera o vetor da busca por significado em
# notas e documentos (2026-10); sem ela, a busca por texto exato segue
# funcionando e o backfill horário do worker só espera a chave aparecer.

# Leitura de foto/PDF enviado pela pessoa (2026-10) — usa a ANTHROPIC_API_KEY
# já configurada (visão do Claude). Opcional: modelo próprio pra esta leitura
# (default = ANTHROPIC_MODEL). Sem ANTHROPIC_API_KEY, cai na OpenAI só pra imagem.
DOCUMENT_VISION_MODEL=

# Checkout real de assinatura (2026-10, decisão do dono do produto) — Asaas,
# R$ 27,90/mês (packages/core/src/payments/plan.ts). ASAAS_ENV=sandbox por
# padrão (freio de segurança: só cobra de verdade com production explícito,
# depois de testar no sandbox). ASAAS_API_KEY é o "access_token" da conta
# Asaas (Minha conta > Integrações > API). Webhook configurado manualmente
# no painel da Asaas (Integrações > Webhooks): URL =
# {WEB_APP_URL}/api/payments/webhook-asaas, eventos PAYMENT_CONFIRMED e
# PAYMENT_RECEIVED, "Token de autenticação" = o MESMO valor de
# ASAAS_WEBHOOK_TOKEN abaixo (vira o header asaas-access-token que a rota
# valida).
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Previsão do tempo do Resumo Matinal (2026-10, ver CLAUDE.md) — OpenWeatherMap,
# endpoint gratuito "5 day / 3 hour forecast" (sem assinatura/cartão). Opcional:
# sem ela, a 1ª mensagem do resumo matinal sai sem a frase de previsão, nunca
# com clima inventado (mesmo padrão de degradação graciosa de WEB_SEARCH_API_KEY).
# A mesma chave serve a tool get_weather (qualquer cidade do Brasil, 2026-10).
# Câmbio/Selic/CDI/IPCA (tool get_market_rate) vêm da API pública do Banco
# Central (api.bcb.gov.br) — sem chave, nada a configurar.
# Criar em https://home.openweathermap.org/users/sign_up.
OPENWEATHERMAP_API_KEY=

# Link wa.me (2026-10, pedido do dono do produto) — abre o WhatsApp do Tom
# direto com uma mensagem pré-preenchida ("Oi Tom!" por padrão). Número de
# telefone REAL do WhatsApp Business do Tom (DDI+DDD, só dígitos, ex.:
# 5511999999999) — diferente de WHATSAPP_PHONE_NUMBER_ID (identificador
# opaco da Cloud API, não serve pra montar esse link). Sem essa variável,
# get_referral_info e o painel caem de volta pro "indicado <código>" manual.
TOM_WHATSAPP_NUMBER=
