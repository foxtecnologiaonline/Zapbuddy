# Supabase (Postgres + Storage + Auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Canal WhatsApp — 'cloud-api' (default, único aprovado para produção com
# usuários reais) ou 'evolution' (fallback/contingência — ver amendamento no
# CLAUDE.md). NÃO setar 'evolution' em produção salvo decisão explícita.
WHATSAPP_CHANNEL_PROVIDER=cloud-api

# WhatsApp Cloud API (Meta) — oficial, canal default
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Evolution API — só usado quando WHATSAPP_CHANNEL_PROVIDER=evolution
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_WEBHOOK_SECRET=

# Claude (Anthropic) — orquestrador LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Dashboard web
WEB_APP_URL=http://localhost:3000
SESSION_SECRET=

# Transcrição de áudio — decisão de provedor pendente (ver packages/core/src/audio/transcriber.ts)
AUDIO_TRANSCRIBER_PROVIDER=
