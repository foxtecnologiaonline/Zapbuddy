# Copie para .env (cp .env.example .env) e preencha. NÃO comite o .env.
EVO_VERSION=latest

# Subdomínio público que você criará no DNS (registro A → IP do VPS)
DOMAIN=evo.seudominio.com

# Chave de acesso à API do Evolution. Gere com: openssl rand -hex 32
AUTHENTICATION_API_KEY=

# Senha do Postgres interno (qualquer string forte). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
