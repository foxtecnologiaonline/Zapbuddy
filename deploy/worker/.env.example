# Copie para .env nesta mesma pasta (deploy/worker/.env) e preencha.
# REDIS_URL NÃO entra aqui — o docker-compose.yml já aponta pro Redis
# interno (redis://redis:6379). Todo o resto é espelho do que está na Vercel.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (Anthropic) — mesmo modelo usado na Vercel
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Canal WhatsApp — precisa ser IDÊNTICO ao configurado na Vercel
# ('cloud-api' em produção com usuários reais; 'evolution' só em
# staging/contingência — ver amendamento no CLAUDE.md).
WHATSAPP_CHANNEL_PROVIDER=cloud-api

# WhatsApp Cloud API — só usado se WHATSAPP_CHANNEL_PROVIDER=cloud-api
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=

# Evolution API — só usado se WHATSAPP_CHANNEL_PROVIDER=evolution
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Transcrição de áudio — pelo menos uma das duas
GROQ_API_KEY=
OPENAI_API_KEY=
MAX_AUDIO_DURATION_SEC=600
